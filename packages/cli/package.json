{
  "name": "buildrax",
  "version": "0.0.0",
  "description": "BuildRAX command line interface",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "bin": {
    "buildrax": "./dist/bin.js"
  },
  "dependencies": {
    "@buildrax/context": "workspace:*",
    "@buildrax/cost": "workspace:*",
    "@buildrax/graph": "workspace:*",
    "@buildrax/ingest": "workspace:*",
    "@buildrax/ir": "workspace:*",
    "@buildrax/pricing": "workspace:*",
    "@buildrax/research": "workspace:*",
    "@buildrax/skills": "workspace:*",
    "@buildrax/viewer": "workspace:*",
    "commander": "^15.1.0"
  }
}
