{
  "name": "@buildrax/viewer",
  "version": "0.0.0",
  "description": "Offline blueprint viewer (read-only, with notes overlay)",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buildrax/graph": "workspace:*",
    "@buildrax/ir": "workspace:*"
  },
  "devDependencies": {
    "elkjs": "^0.12.1",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
